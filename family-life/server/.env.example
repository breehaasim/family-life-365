PORT=5000
# Local MongoDB or your MongoDB Atlas connection string (put your own here, never commit the real one)
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/familylife?retryWrites=true&w=majority
# Admin panel login (first admin is created from these on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123
# Forgot the admin password / changed the email? Set RESET_ADMIN=true, start the server once, then remove this line.
RESET_ADMIN=
# Long random text, used to sign admin login tokens (required in production)
JWT_SECRET=change-this-to-a-long-random-string
# Optional: old v4 API key still works for scripts. Leave empty to disable.
ADMIN_KEY=
# Optional: real AI answers for the chatbot (it uses your database content as its knowledge)
ANTHROPIC_API_KEY=
# Optional: only needed if frontend and backend are on different domains (comma separated)
CLIENT_ORIGIN=
